          "v": 1,
          "column": 0,
          "fields": {
            "text": "Turning pain into power",
            "level": "h2",
            "size": "auto",
            "eyebrow": "My path",
            "subheading": "My path into the healing arts began at a very young age, developing my psychic abilities, compassion and sensitivities through intense hardship."
          },
          "variant": "plain"
        },
        {
          "id": "blk_rz4wqajpd1",
          "type": "timeline",
          "v": 1,
          "column": 1,
          "fields": {
            "items": [
              {
                "date": "Early years",
                "text": "Hardship shaped my psychic abilities, compassion and sensitivities from a young age.",
                "title": "A sensitive beginning"
              },
              {
                "date": "Late teens",
                "text": "Accidents, surgeries and severe spinal pain launched me onto the path of seeking what would truly heal.",
                "title": "The catalyst"
              },
              {
                "date": "A decade of study",
                "text": "Yoga of the voice, ancestral healing, NLP, Internal Family Systems, energy healing, chi gong, Tao tantra, improv, meditation, plant medicine, yin yoga, sound healing and women's circle facilitation.",
                "title": "Traveling the world"
              },
              {
                "date": "Today",
                "text": "A private healing practice helping others turn their pain into power, access their creative potential and live a life they love.",
                "title": "Boulder, Colorado"
              }
            ]
          },
          "variant": "vertical"
        }
      ]
    },
