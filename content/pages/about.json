        {
          "id": "blk_7dan89sf8e",
          "type": "heading",
          "v": 1,
          "column": 1,
          "fields": {
            "text": "Hello, I'm Courtney",
            "level": "h1",
            "size": "h1",
            "eyebrow": "About",
            "subheading": "ceremony is my love language"
          },
          "variant": "plain"
        },
        {
          "id": "blk_eb14e06dgt",
          "type": "text",
          "v": 1,
          "column": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I'm an intuitive healer, embodiment guide, ceremonialist and sound priestess living in Boulder, Colorado, fueled with a passion for the healing arts and women's empowerment."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I've spent the last decade traveling the globe, learning transformational tools and studying healing modalities in diverse teachings and ancient wisdom traditions. Through ceremonies, retreats, mentorships and healing sessions, I create spaces where people can finally exhale — where the body feels safe, the heart opens and the voice remembers its song."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "I'm here as an ally in your liberation, leadership, and the embodiment of all that you are.",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "variant": "default"
        },
        {
          "id": "blk_bw1b1yymfx",
          "type": "button",
          "v": 1,
          "column": 1,
          "fields": {
